# -----------------------------------------------------------------------------
# Skipline Hub environment configuration
# Copy this file to .env.local and adjust values for your deployment.
# -----------------------------------------------------------------------------

# Public origin used for links inside verification / reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite database file. Relative paths resolve from the project root.
DATABASE_PATH=data/skipline.db

# Session / cookie hardening
# Set to "true" when serving over HTTPS (required in production).
COOKIE_SECURE=false
SESSION_DAYS=30

# Seed an initial administrator. If omitted, defaults are used ONLY for local
# development: admin@skiplinehub.app / Admin@12345. Change before deploying!
ADMIN_NAME=Skipline Administrator
ADMIN_EMAIL=admin@skiplinehub.app
ADMIN_PASSWORD=Admin@12345

# Demo data (organizations, users, historical tickets). Set false in production
# if you want a completely empty platform.
SEED_DEMO_DATA=true

# Optional SMTP transport. When not configured, emails are written to
# data/outbox.log and (outside production) the UI shows the action link
# directly so local verification / password reset can still be completed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Skipline Hub <no-reply@skiplinehub.app>"

# Optional Google Maps JavaScript API key. When set, maps use Google Maps and
# fall back to OpenStreetMap if the key or script is unavailable. Restrict the
# key to your localhost and production domains in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional OpenStreetMap tile fallback. Defaults to public OpenStreetMap tiles.
# For production traffic, use a tile provider with an appropriate usage plan.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
